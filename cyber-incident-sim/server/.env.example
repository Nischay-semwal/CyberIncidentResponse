# Copy this file to .env — defaults below work as-is for local Docker Compose.

# Overridden by docker-compose.yml when running in containers; used as-is
# when running the backend directly on your host machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyber_incident_sim?schema=public

PORT=4000
NODE_ENV=development

SESSION_COOKIE_NAME=cis_session
SESSION_TTL_DAYS=7
FRONTEND_URL=http://localhost:5173